# Salin ke .env untuk deployment. Jangan commit file .env yang berisi secret.
APP_ENV=production
HOST=0.0.0.0
PORT=8080
DATABASE_PATH=/data/vibelog.db
# Wajib di production: minimal 32 karakter, acak, dan rahasia.
JWT_SECRET=isi-dengan-secret-acak-minimal-32-karakter
JWT_EXPIRY_HOURS=24

# URL publik aplikasi. Dipakai untuk link magic link dan callback GitHub.
FRONTEND_URL=https://vibelog.example.com

# Proxy tepercaya (IP atau CIDR, pisah koma) yang boleh mengisi X-Forwarded-For.
# Kosongkan hanya kalau aplikasi diakses langsung tanpa reverse proxy.
TRUSTED_PROXIES=

# Magic link email lewat Resend. Kosongkan untuk mematikan login via email.
RESEND_API_KEY=

# GitHub OAuth (opsional). Callback: {FRONTEND_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
