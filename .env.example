# Salin ke .env untuk Docker Compose. Jangan commit file .env.
APP_ENV=production

# URL publik tempat aplikasi dibuka. Wajib benar: dipakai untuk link magic
# link, callback GitHub, dan origin CORS. Tanpa trailing slash.
BASE_URL=http://localhost:8090

# Port host yang dipublikasikan Docker (container selalu 8080).
PORT=8090

# Secret JWT. Kosongkan agar dibuat otomatis di volume /data (disarankan).
# Isi minimal 32 karakter hanya bila ingin mengelola secret sendiri.
JWT_SECRET=

# Lama sesi login.
JWT_EXPIRY_HOURS=24

# Pendaftaran akun baru. Set false setelah akun sendiri dibuat kalau instance
# ini hanya untuk kamu.
ALLOW_REGISTRATION=true

# Proxy tepercaya yang boleh mengisi X-Forwarded-For (IP atau CIDR, pisah
# koma). Kosongkan bila diakses langsung. Contoh di belakang nginx:
# TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=

# ---- Email (magic link) ----
# console: tautan dicetak ke log container (paling mudah untuk self-host)
# smtp:    server SMTP sendiri
# resend:  Resend API (cloud berbayar)
# off:     matikan login via email
EMAIL_DRIVER=console
EMAIL_FROM=VibeLog <no-reply@localhost>

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls | implicit (port 465) | none
# Kosongkan untuk menebak dari port: 465 = implicit, lainnya starttls.
SMTP_TLS=

RESEND_API_KEY=

# ---- GitHub OAuth (opsional) ----
# Callback: {BASE_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
