# Salin ke .env untuk deployment. Jangan commit file .env yang berisi secret.
APP_ENV=production
HOST=0.0.0.0
PORT=8080
DATABASE_PATH=/data/vibelog.db
# Wajib di production: minimal 32 karakter, acak, dan rahasia.
JWT_SECRET=isi-dengan-secret-acak-minimal-32-karakter
JWT_EXPIRY_HOURS=24
FRONTEND_URL=https://vibelog.example.com
